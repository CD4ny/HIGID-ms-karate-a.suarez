generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Indicator {
  id                Int                 @id @default(autoincrement())
  code              String
  name              String
  type              String
  actionType        String
  deleted           Boolean             @default(false)
  owner             String
  IndicatorOnKumite IndicatorOnKumite[]
}

model Karateca {
  id                                 Int                                  @id @default(autoincrement())
  name                               String
  lastName                           String
  sex                                String
  weight                             String
  category                           String
  deleted                            Boolean                              @default(false)
  owner                              String
  pic                                String?
  CompetitiveActivityKarateca_Kumite CompetitiveActivityKarateca_Kumite[]
}

model CompetitiveActivity {
  id                                 Int                                  @id @default(autoincrement())
  desc                               String
  type                               String
  startDate                          DateTime?
  endDate                            DateTime?
  deleted                            Boolean                              @default(false)
  owner                              String
  CompetitiveActivityKarateca_Kumite CompetitiveActivityKarateca_Kumite[]
}

model CompetitiveActivityKarateca_Kumite {
  id                  Int                 @id @default(autoincrement())
  deleted             Boolean             @default(false)
  karatecaId          Int
  activityId          Int
  owner               String
  competitiveActivity CompetitiveActivity @relation(fields: [activityId], references: [id])
  karateca            Karateca            @relation(fields: [karatecaId], references: [id])
  Kumite              Kumite[]
}

model Kumite {
  id                                 Int                                @id @default(autoincrement())
  gi                                 String
  deleted                            Boolean                            @default(false)
  comp_Karat_Id                      Int
  owner                              String
  video                              String?
  evaluation                         String?
  IndicatorOnKumite                  IndicatorOnKumite[]
  CompetitiveActivityKarateca_Kumite CompetitiveActivityKarateca_Kumite @relation(fields: [comp_Karat_Id], references: [id])
}

model IndicatorOnKumite {
  id                 Int       @id @default(autoincrement())
  value              String?
  deleted            Boolean   @default(false)
  indicatorId        Int
  kumiteId           Int
  owner              String
  distance           String?
  informalWarnings   String?
  kumiteEnding       String?
  kumiteType         String?
  levelOfPreparation String?
  motorSequence      String?
  officialWarnings   String?
  partialTimes       String?
  penalties          String?
  sequenceType       String?
  strikeZones        String?
  indicator          Indicator @relation(fields: [indicatorId], references: [id])
  kumite             Kumite    @relation(fields: [kumiteId], references: [id])
}
